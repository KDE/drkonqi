[Unit]
Description=Cleaning DrKonqi data
PartOf=plasma-core.target
After=timers.target

[Timer]
# Purely for users that always supend, they'd not get cruft cleaned up on login.
# That's also why persistence is of no value or use.
OnCalendar=weekly
Persistent=false

[Install]
# When making changes here also make sure to replicate them in CMake.
WantedBy=plasma-core.target
