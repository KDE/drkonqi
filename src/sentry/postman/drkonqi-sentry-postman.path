[Unit]
Description=Submitting pending crash events (file monitor)
PartOf=plasma-core.target
After=default.target

[Path]
PathExistsGlob=%C/drkonqi/sentry-envelopes/*
MakeDirectory=true
TriggerLimitIntervalSec=30 minutes
TriggerLimitBurst=4

[Install]
# When making changes here also make sure to replicate them in CMake.
WantedBy=plasma-core.target
